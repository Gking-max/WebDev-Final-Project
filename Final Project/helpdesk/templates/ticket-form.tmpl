<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>HelpDesk | Support Ticket</title>
  <link rel="stylesheet" href="/static/reset.css">
  <link rel="stylesheet" href="/static/token.css">
  <link rel="stylesheet" href="/static/main.css">
</head>
<body>
  <div class="app-shell">
    <aside class="navigation-rail" aria-label="HelpDesk navigation">
      <div class="brand-block">
        <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14v-2a8 8 0 0116 0v2"/><rect x="3" y="13" width="4" height="6" rx="1"/><rect x="17" y="13" width="4" height="6" rx="1"/><path d="M19 19c0 2-2 3-4 3h-2"/></svg>
        <div class="brand-copy">
          <p class="brand-name">HelpDesk</p>
          <p class="brand-subtitle">IT Support for Students</p>
        </div>
      </div>

      <nav class="primary-navigation" aria-label="Primary">
        <ul class="navigation-list">
          <li><a class="navigation-link" href="/tickets/create" aria-current="page">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v8M8 12h8"/></svg>
            <span>Support ticket</span>
          </a></li>
          <li><a class="navigation-link" href="/software-requests/create">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 00-2 2v14a2 2 0 002 2h10a2 2 0 002-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h6"/></svg>
            <span>Software request</span>
          </a></li>
          <li><a class="navigation-link" href="/tickets">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3h6v3H9z"/><path d="M15 4.5h3a2 2 0 012 2V20a2 2 0 01-2 2H6a2 2 0 01-2-2V6.5a2 2 0 012-2h3"/><path d="M8 12h8M8 16h8"/></svg>
            <span>My tickets</span>
          </a></li>
          <li><a class="navigation-link" href="/software-requests">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h16M4 12h16M4 19h16"/></svg>
            <span>Software requests</span>
          </a></li>
        </ul>
      </nav>

      <div class="rail-account">
        <a class="navigation-link logout-link" href="#logout">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><path d="M16 17l5-5-5-5M21 12H9"/></svg>
          <span>Log out</span>
        </a>
      </div>
    </aside>

    <div class="main-side">
      <header class="topbar">
        <div class="user-menu" aria-label="Signed in as Maya">
          <span class="user-avatar" aria-hidden="true">M</span>
          <span class="user-name">Maya</span>
          <span class="user-chevron" aria-hidden="true"></span>
        </div>
      </header>

      <main class="workspace" id="dashboard" aria-label="Dashboard">
        {{if .ID}}
        <p class="eyebrow">EDIT TICKET #{{.ID}}</p>
        <h1>Edit support ticket</h1>
        {{else}}
        <p class="eyebrow">NEW SUPPORT REQUEST</p>
        <h1>Support ticket</h1>
        {{end}}
        <p class="subtitle">All fields are required.</p>
        
        <form action="{{if .ID}}/tickets/{{.ID}}/edit{{else}}/tickets/create{{end}}" method="POST" class="lab-form">
          <div class="form-grid">
            <div class="field">
              <label for="title">Ticket title</label>
              <input id="title" name="title" type="text" value="{{.Title}}" 
                {{if .TitleError}}aria-describedby="title-error" aria-invalid="true"{{end}} required>
              {{if .TitleError}}<p class="error" id="title-error">{{.TitleError}}</p>{{end}}
            </div>
            
            <div class="field">
              <label for="location">Room or location</label>
              <input id="location" name="location" type="text" value="{{.Location}}"
                {{if .LocationError}}aria-describedby="location-error" aria-invalid="true"{{end}} required>
              {{if .LocationError}}<p class="error" id="location-error">{{.LocationError}}</p>{{end}}
            </div>
            
            <div class="field field--full">
              <label for="category">Support category</label>
              <select id="category" name="category" 
                {{if .CategoryError}}aria-describedby="category-error" aria-invalid="true"{{end}} required>
                <option value="">Select a category</option>
                <option value="Network" {{if eq .Category "Network"}}selected{{end}}>Network</option>
                <option value="Email" {{if eq .Category "Email"}}selected{{end}}>Email</option>
                <option value="Hardware" {{if eq .Category "Hardware"}}selected{{end}}>Hardware</option>
                <option value="Other" {{if eq .Category "Other"}}selected{{end}}>Other</option>
              </select>
              {{if .CategoryError}}<p class="error" id="category-error">{{.CategoryError}}</p>{{end}}
            </div>
            
            <div class="field field--full">
              <label for="description">Description</label>
              <textarea id="description" name="description" 
                {{if .DescriptionError}}aria-describedby="description-error" aria-invalid="true"{{end}} required>{{.Description}}</textarea>
              {{if .DescriptionError}}<p class="error" id="description-error">{{.DescriptionError}}</p>{{end}}
              <p class="hint">Describe the need clearly. Maximum 500 code points.</p>
            </div>
          </div>
          
          <div class="form-actions">
            <button type="submit" class="btn-primary">{{if .ID}}Save changes{{else}}Create ticket{{end}}</button>
            {{if .ID}}
            <a href="/tickets/{{.ID}}">Cancel</a>
            {{else}}
            <a href="/tickets">View saved records</a>
            {{end}}
          </div>
        </form>
      </main>
    </div>
  </div>
</body>
</html>